  </picture>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <nav class="crumb crumb-dark" aria-label="Breadcrumb" style="padding-top:0">
        <ol class="crumb-list">
          <li><a href="../../">Startseite</a></li>
          <li><a href="../../luxusreisen/">Luxusreisen</a></li>
          <li><span aria-current="page">Malediven</span></li>
        </ol>
      </nav>

      <h1 class="reveal" style="--d:.08s">Luxusurlaub Malediven,<br><em>geplant von Menschen,</em><br>die dort waren.</h1>
      <p class="hero-sub reveal" style="--d:.16s">
        Rund 170 Resorts nennen sich hier Luxus. Sie unterscheiden sich massiv –
        im Hausriff, in der Lagune, im Transfer, im Umgang mit Kindern.
        Wir sagen Ihnen, welches zu Ihnen passt. Auch wenn es das günstigere ist.
      </p>
      <ul class="hero-usp reveal" style="--d:.24s">
        <li>Resorts persönlich inspiziert, nicht aus dem Katalog</li>
        <li>Transfer, Flugzeiten und Gezeiten mitgeplant</li>
        <li>Angebot kostenlos und unverbindlich</li>
      </ul>
    </div>

    <!-- Konfigurator mit vorbelegtem Ziel -->
    <div class="cfg reveal" id="anfrage" style="--d:.3s">
      <form class="cfg-form" id="cfgMv" data-ziel="Malediven" action="../../anfrage.php" method="post" novalidate>

        <!-- Spamschutz und Herkunft: von anfrage.php ausgewertet.

             Zwei Fallen statt einer. Beide sind für Menschen unsichtbar und
             müssen leer bleiben; wer sie ausfüllt, war kein Mensch.

             Die zweite heisst absichtlich "url": Werbeautomaten suchen in
             Formularen gezielt nach einem Feld für die eigene Adresse und
             füllen es, wo sie eines finden. Der umgebende Block liegt weit
             ausserhalb des Bildes und ist der Vorlesesoftware entzogen;
             tabindex="-1" hält zusätzlich Tab-Taste und Anker-Fokus fern. -->
        <div class="cfg-hp" aria-hidden="true">
          <label for="cfgMv-website">Bitte nicht ausfüllen</label>
          <input type="text" id="cfgMv-website" name="website" tabindex="-1" autocomplete="off">
          <label for="cfgMv-url">Ihre Website</label>
          <!-- tabindex="-1" ist auch hier Pflicht: ohne den Ausschluss ist das
               Feld per Tab-Taste und Anker-Fokus erreichbar, und ein echter
               Besucher tippt unsichtbar hinein. Automaten, die Felder aus dem
               Quelltext lesen, stört das Attribut nicht. -->
          <input type="text" id="cfgMv-url" name="url" tabindex="-1" autocomplete="off">
        </div>
        <input type="hidden" name="_t" data-rolle="zeit" value="0">
        <input type="hidden" name="_quelle" data-rolle="quelle" value="">
        <!-- Nachweis, dass das Formular im Browser aufgebaut wurde. main.js
             trägt hier einen Tageswert ein. Bleibt das Feld leer, wurde die
             Adresse direkt angesprochen, ohne die Seite je darzustellen. -->
        <input type="hidden" name="_p" data-rolle="nachweis" value="">

        <div class="cfg-head">
          <p class="cfg-eyebrow">Kostenlos &amp; unverbindlich</p>
          <h2 class="cfg-title">Malediven anfragen</h2>

          <ol class="cfg-steps" aria-label="Fortschritt der Anfrage">
            <li class="cfg-stepitem"><button type="button" class="cfg-jump" data-step="0">Ziel</button></li>
            <li class="cfg-stepitem"><button type="button" class="cfg-jump" data-step="1">Reise</button></li>
            <li class="cfg-stepitem"><button type="button" class="cfg-jump" data-step="2">Reisende</button></li>
            <li class="cfg-stepitem"><button type="button" class="cfg-jump" data-step="3">Kontakt</button></li>
          </ol>
        </div>

        <!-- 1 · Ziel -->
        <fieldset class="cfg-step is-active" data-name="Ziel">
          <legend class="cfg-q">Ihr Reiseziel ist gesetzt – passt das?</legend>
          <div class="chips" role="group" aria-label="Reiseziel wählen">
            <label class="chip "><input type="radio" name="ziel" value="Malediven"><span>Malediven</span></label>
            <label class="chip "><input type="radio" name="ziel" value="Mauritius"><span>Mauritius</span></label>
            <label class="chip "><input type="radio" name="ziel" value="Seychellen"><span>Seychellen</span></label>
            <label class="chip "><input type="radio" name="ziel" value="Dubai &amp; Orient"><span>Dubai &amp; Orient</span></label>
            <label class="chip "><input type="radio" name="ziel" value="Afrika"><span>Afrika</span></label>
            <!-- Das Eingabefeld sitzt IM Chip: Ein Klick auf „Anderes Ziel"
                 verwandelt den Chip direkt in ein Textfeld, statt darunter ein
                 zweites Feld aufzuklappen. Ein Schritt weniger bis zur Anfrage.
                 Gewünscht von Manuel am 29.08.2026. -->
            <label class="chip chip-open chip-frei">
              <input type="radio" name="ziel" value="Anderes Ziel">
              <span>Anderes Ziel eingeben</span>
              <input type="text" id="cfgMv-zielfrei" name="ziel_frei" data-rolle="zielfrei"
                     class="chip-frei-feld" placeholder="Wohin möchten Sie?"
                     autocomplete="off" aria-label="Ihr Wunschziel">
            </label>
            <label class="chip chip-open"><input type="radio" name="ziel" value="Noch offen"><span>Noch offen – beraten Sie mich</span></label>
          </div>

          <div class="field cfg-ziel-frei" hidden>
            <p class="field-hint">Amerika, Südsee, Fernost – wir beraten auch zu Zielen, die oben nicht stehen.</p>
            <p class="cfg-err" data-err="zielfrei" role="alert" hidden>Bitte geben Sie Ihr Wunschziel an.</p>
          </div>

          <p class="cfg-err" data-err="ziel" role="alert" hidden>Bitte wählen Sie ein Reiseziel.</p>
        </fieldset>

        <!-- 2 · Reise -->
        <fieldset class="cfg-step" data-name="Reise">
          <legend class="cfg-q">Wie soll Ihre Reise aussehen?</legend>

          <div class="field cfg-hotelwahl">
            <label for="cfgMv-hotel">Wunschhotel <span class="opt">(optional)</span></label>
            <div class="cfg-hotelfeld">
              <input type="text" id="cfgMv-hotel" name="hotel" data-rolle="hotel"
                     role="combobox" aria-expanded="false" aria-autocomplete="list"
                     aria-controls="cfgMv-hotelliste" autocomplete="off"
                     placeholder="Aus unserer Liste wählen oder selbst eintippen">
              <button type="button" class="cfg-hotel-auf" tabindex="-1" aria-label="Hotelliste öffnen">
                <svg width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              </button>
              <button type="button" class="cfg-hotel-clear" hidden aria-label="Wunschhotel entfernen">
                <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </button>
            </div>
            <ul class="cfg-hotelliste" id="cfgMv-hotelliste" role="listbox" aria-label="Hotelvorschläge" hidden></ul>
            <p class="field-hint cfg-hotel-hint">Ihr Wunschhaus ist nicht dabei? Einfach eintippen – wir vermitteln auch darüber hinaus.</p>
          </div>

          <p class="cfg-sub">Worauf legen Sie besonders Wert?</p>
          <div class="chips-sm" role="group" aria-label="Reisestil">
            <label class="chip chip-multi"><input type="checkbox" name="stil" value="Ruhe &amp; Privatsphäre"><span>Ruhe &amp; Privatsphäre</span></label>
            <label class="chip chip-multi"><input type="checkbox" name="stil" value="Honeymoon"><span>Honeymoon</span></label>
            <label class="chip chip-multi"><input type="checkbox" name="stil" value="Mit Kindern"><span>Mit Kindern</span></label>
            <label class="chip chip-multi"><input type="checkbox" name="stil" value="Adults Only"><span>Adults Only</span></label>
            <label class="chip chip-multi"><input type="checkbox" name="stil" value="Hausriff &amp; Schnorcheln"><span>Hausriff &amp; Schnorcheln</span></label>
            <label class="chip chip-multi"><input type="checkbox" name="stil" value="Tauchen"><span>Tauchen</span></label>
            <label class="chip chip-multi"><input type="checkbox" name="stil" value="Wellness &amp; Spa"><span>Wellness &amp; Spa</span></label>
            <label class="chip chip-multi"><input type="checkbox" name="stil" value="Kulinarik"><span>Kulinarik</span></label>
          </div>
          <p class="field-hint">Mehrfachauswahl möglich – danach richtet sich unsere Empfehlung.</p>

          <!-- Die Auswahl oben ist eine geschlossene Liste. Wer etwas mitbringt,
               das dort nicht steht – barrierefrei, Hund dabei, Tauchbrevet,
               Jubiläum – soll es genau hier sagen können und nicht erst drei
               Schritte später im Notizfeld. -->
          <div class="field cfg-stilfrei">
            <label for="cfgMv-stilfrei">Etwas anderes, das Ihnen wichtig ist? <span class="opt">(optional)</span></label>
            <input type="text" id="cfgMv-stilfrei" name="stil_frei" maxlength="200"
                   placeholder="z. B. barrierefrei, Hund reist mit, Jubiläum, Tauchbrevet …" autocomplete="off">
          </div>

          <div class="cfg-row" style="margin-top:1.15rem">
            <div class="field">
              <label for="cfgMv-zeitraum">Reisezeitraum</label>
              <select id="cfgMv-zeitraum" name="zeitraum" data-rolle="zeitraum">
                <option value="">Noch flexibel</option>
                <option>Januar – April (Trockenzeit)</option>
                <option>Mai – Juli</option>
                <option>August</option>
                <option>September – Oktober</option>
                <option>November – Dezember</option>
                <option value="Genaues Datum">Genaues Datum wählen …</option>
              </select>
            </div>
            <div class="field">
              <label for="cfgMv-dauer">Reisedauer</label>
              <select id="cfgMv-dauer" name="dauer">
                <option value="">Noch offen</option>
                <option>7 Nächte</option>
                <option>8–12 Nächte</option>
                <option>13–20 Nächte</option>
                <option>Kombination mit Dubai o. Ä.</option>
              </select>
            </div>
          </div>

          <div class="cfg-row cfg-datum" hidden>
            <div class="field">
              <label for="cfgMv-datum-von">Anreise <span aria-hidden="true">*</span></label>
              <input type="date" id="cfgMv-datum-von" name="datum_von" data-rolle="datum-von" autocomplete="off">
            </div>
            <div class="field">
              <label for="cfgMv-datum-bis">Abreise <span aria-hidden="true">*</span></label>
              <input type="date" id="cfgMv-datum-bis" name="datum_bis" data-rolle="datum-bis" autocomplete="off">
            </div>
            <p class="cfg-err" data-err="datum" role="alert" hidden>Bitte wählen Sie An- und Abreisedatum.</p>
          </div>
        </fieldset>

        <!-- 3 · Reisende -->
        <fieldset class="cfg-step" data-name="Reisende">
          <legend class="cfg-q">Wer reist mit?</legend>
          <div class="cfg-row">
            <div class="field">
              <label for="cfgMv-erw">Erwachsene</label>
              <select id="cfgMv-erw" name="erwachsene">
                <option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option><option>6 oder mehr</option>
              </select>
            </div>
            <div class="field">
              <label for="cfgMv-kinder">Kinder</label>
              <select id="cfgMv-kinder" name="kinder">
                <option selected>0</option><option>1</option><option>2</option><option>3</option><option>4 oder mehr</option>
              </select>
            </div>
          </div>

          <div class="field cfg-kids-ages" hidden>
            <label for="cfgMv-alter">Alter der Kinder bei Reisebeginn</label>
            <input type="text" id="cfgMv-alter" name="kinderalter" placeholder="z. B. 4 und 7">
            <p class="field-hint">Manche Resorts sind Adults Only, andere haben Altersgrenzen im Kids Club.</p>
          </div>

          <div class="field">
            <label for="cfgMv-villa">Wunsch-Villenkategorie <span class="opt">(optional)</span></label>
            <select id="cfgMv-villa" name="villa">
                <option value="">Noch offen – bitte beraten</option>
                <option>Strandvilla</option>
                <option>Strandvilla mit Pool</option>
                <option>Overwater-Villa</option>
                <option>Overwater-Villa mit Pool</option>
                <option>Kombination Strand + Overwater</option>
                <option>Private Residence / ganze Insel</option>
            </select>
          </div>
          <div class="field">
            <!-- Kein „(optional)" mehr: Im alten Formular beantworteten
                 99,9 % der Anfragenden das Budget – es ist DAS Feld, das eine
                 Anfrage beratbar macht. Verpflichtend ist es weiterhin nicht
                 (die Leer-Auswahl bleibt), aber es lädt nicht mehr zum
                 Überspringen ein. -->
            <label for="cfgMv-budget">Budget pro Person</label>
            <select id="cfgMv-budget" name="budget">
                <option value="">Bitte wählen …</option>
                <option>bis 4.000 €</option>
                <option>4.000 – 7.000 €</option>
                <option>7.000 – 12.000 €</option>
                <option>12.000 – 20.000 €</option>
                <option>ab 20.000 €</option>
            </select>
            <p class="field-hint">Hilft uns, gleich passende Häuser vorzuschlagen – statt zu raten.</p>
          </div>


          <div class="field">
            <label for="cfgMv-flug">Flugklasse <span class="opt">(optional)</span></label>
            <select id="cfgMv-flug" name="flugklasse">
                <option value="">Noch offen</option>
                <option>Economy</option>
                <option>Premium Economy</option>
                <option>Business Class</option>
                <option>First Class</option>
                <option>Ohne Flug – nur Hotel</option>
            </select>
          </div>
        </fieldset>

        <!-- 4 · Kontakt. Nicht „Ihre Daten bitte", sondern der Lieferweg der
             bestellten Vorschläge: Die Wohin-Frage macht Name und E-Mail zur
             Zustelladresse statt zur Datenpreisgabe, die Mikrozeile sagt
             „fast geschafft", die Unterzeile beantwortet Warum und
             Was-danach. „Vorschläge" ist bewusst neutral – dieselbe Zeile
             steht auch im Yacht-, Privatjet- und Kreuzfahrt-Formular. -->
        <fieldset class="cfg-step" data-name="Kontakt">
          <!-- Die Mikrozeile steht IM legend: Browser rendern ein legend
               immer als erstes Kind des fieldset, ein Absatz davor rutscht
               darunter. „cfg-zusage" statt „cfg-sub" – cfg-sub ist bereits
               als Zwischentitel-Klasse mit Versalien vergeben. -->
          <legend class="cfg-q"><span class="cfg-letzter">Letzter Schritt</span>Wohin dürfen wir Ihre Vorschläge senden?</legend>
          <p class="cfg-zusage">Ihr persönlicher Reisedesigner meldet sich innerhalb von
          24&nbsp;Stunden mit ersten Vorschlägen – auf dem Weg, den Sie hier wählen.
          Ob es weitergeht, entscheiden Sie danach in aller Ruhe.</p>

          <div class="cfg-summary" hidden>
            <p class="cfg-summary-h">Ihre Angaben</p>
            <ul class="cfg-summary-list"></ul>
          </div>

          <!-- Der konkrete Gegenwert am Ort der Entscheidung: Die Zusage am
               Schrittkopf ist auf dem Handy längst aus dem Bild gescrollt,
               wenn die Finger tippen sollen – sichtbar wäre sonst nur noch
               die Forderung nach Name und E-Mail. Wortlaut gedeckt durch
               „Mit Begründung, warum genau diese Auswahl" auf der
               Startseite; bewusst „Vorschläge" ohne „Häuser", weil dieselbe
               Zeile auch im Yacht-, Privatjet- und Kreuzfahrt-Formular steht. -->
          <p class="cfg-nutzen">Sie erhalten zwei bis drei durchdachte Vorschläge,
          die zu Ihren Angaben passen – mit Begründung, warum genau diese Auswahl.</p>

          <div class="field">
            <label for="cfgMv-name">Name <span aria-hidden="true">*</span></label>
            <input type="text" id="cfgMv-name" name="name" data-rolle="name" autocomplete="name" required>
            <p class="cfg-err" data-err="name" role="alert" hidden>Bitte geben Sie Ihren Namen an.</p>
          </div>
          <div class="field">
            <label for="cfgMv-mail">E-Mail <span aria-hidden="true">*</span></label>
            <input type="email" id="cfgMv-mail" name="email" data-rolle="mail" autocomplete="email" inputmode="email" required>
            <p class="cfg-err" data-err="mail" role="alert" hidden>Bitte geben Sie eine gültige E-Mail-Adresse an.</p>
          </div>
          <div class="field">
            <label for="cfgMv-tel">Telefon <span class="opt">(optional)</span></label>
            <input type="tel" id="cfgMv-tel" name="telefon" autocomplete="tel" inputmode="tel">
          </div>

          <div class="field">
            <label>Wie möchten Sie kontaktiert werden?</label>
            <div class="chips-sm" role="group" aria-label="Bevorzugter Kontaktweg">
              <label class="chip"><input type="radio" name="kontaktweg" value="E-Mail" checked><span>E-Mail</span></label>
              <label class="chip"><input type="radio" name="kontaktweg" value="Telefon"><span>Telefon</span></label>
              <label class="chip"><input type="radio" name="kontaktweg" value="WhatsApp"><span>WhatsApp</span></label>
            </div>
          </div>

          <div class="field">
            <label for="cfgMv-notiz">Gibt es etwas, das wir wissen sollten? <span class="opt">(optional)</span></label>
            <textarea id="cfgMv-notiz" name="notiz" rows="2" placeholder="Wunschresort, Hochzeitsreise, Tauchbrevet, Abflughafen …"></textarea>
          </div>

          <!-- Datenschutz: Hinweis statt Pflicht-Häkchen. Die Bearbeitung
               einer Anfrage stützt sich auf Art. 6 Abs. 1 lit. b DSGVO –
               eine erzwungene Einwilligungs-Checkbox war rechtlich schief
               und die letzte Pflicht-Hürde vor dem Absenden. Das versteckte
               Feld hält anfrage.php unverändert (dort bleibt die Prüfung
               für ältere, zwischengespeicherte Seiten mit Checkbox), und
               die Fehlerzeile data-err="ds" bleibt für genau diese alten
               Seiten ansprechbar. -->
          <input type="hidden" name="datenschutz" value="1">
          <p class="cfg-err" data-err="ds" role="alert" hidden>Bitte bestätigen Sie die Datenschutzerklärung.</p>
          <p class="cfg-ds-hinweis">Wir verwenden Ihre Angaben ausschließlich zur
          Bearbeitung Ihrer Anfrage. Wie wir mit Ihren Daten umgehen, steht in der
          <a href="../../datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a>.</p>
        </fieldset>

        <div class="cfg-done" hidden aria-live="polite">
          <svg class="done-ico" width="56" height="56" viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".35"/>
            <path d="M14 24.5 21 31.5 34 17.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h3>Ihre Anfrage ist bei uns.</h3>
          <p>Christina Berger, unsere Malediven-Spezialistin, meldet sich innerhalb von 24&nbsp;Stunden – mit ersten konkreten Vorschlägen für <strong class="cfg-done-ziel">Ihre Reise</strong>.</p>
          <p class="done-alt">Sie möchten es schneller? <a href="tel:+492222929009">02222 929009</a> oder <a href="https://wa.me/492222929009" rel="noopener">per WhatsApp</a>.</p>
          <!-- Die Newsletter-Einladung ist vom Kontaktschritt hierher
               gewandert: Vor dem Absenden war sie vier Zeilen Rechtstext
               am Ort der Entscheidung, nach dem Absenden ist sie ein
               Angebot im besten Moment. Der Klick ist die aktive
               Einwilligungshandlung; angemeldet ist erst, wer den Link in
               der Bestätigungsmail klickt (Double-Opt-In über nl.php,
               unverändert). -->
          <div class="cfg-nl">
            <p>Wenn Sie mögen: Unser Newsletter bringt in loser Folge ausgewählte
            Häuser, Routen und Reiseideen in Ihr Postfach – zusammengestellt von
            unseren Reisedesignern.</p>
            <button type="button" class="btn btn-ghost">Newsletter erhalten</button>
            <p class="cfg-nl-klein">Sie bestätigen die Anmeldung kurz per E-Mail.
            Abmelden ist jederzeit mit einem Klick möglich.</p>
          </div>
        </div>

        <p class="cfg-fail" role="alert" tabindex="-1" hidden></p>
        <div class="cfg-foot">
          <button type="button" class="btn btn-ghost cfg-back" hidden>Zurück</button>
          <button type="button" class="btn btn-gold btn-block cfg-next">Weiter</button>
          <button type="submit" class="btn btn-gold btn-block cfg-send" hidden>Unverbindlich anfragen</button>
        </div>
        <!-- Die Zusage steht bewusst HIER, direkt an den Knöpfen. „Kostenlos
             & unverbindlich" am Formularkopf ist im Moment der Entscheidung
             892 px aus dem Bild gescrollt (gemessen bei 375 px Breite) – was
             beim Absenden zählt, muss beim Absenden lesbar sein.
             „Unverbindlich" trägt seit dem 16.08. der Knopf selbst; die
             Zeile endet deshalb nicht mehr auf drei Verneinungen, sondern
             auf dem, was die Person tatsächlich bekommt. -->
        <p class="cfg-note">Keine Buchung, keine Kosten – nur eine persönliche Antwort innerhalb von 24&nbsp;Stunden.</p>
        <p class="cfg-trust">
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5 13.5 3.5v4.2c0 3.2-2.2 5.6-5.5 6.8-3.3-1.2-5.5-3.6-5.5-6.8V3.5Z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
          Ihre Anfrage geht direkt an Ihren persönlichen Reisedesigner – kein Callcenter, kein Verteiler
        </p>
        <!-- Die Belege standen bisher nur auf 2 von 249 Formularseiten – als
             grosser Block auf der Startseite. Hier die kompakte Fassung am Ort
             der Entscheidung. Es sind dieselben Aussagen wie dort, nichts
             hinzuerfunden. -->
        <p class="cfg-belege">
          <span><span class="cfg-belege-stern" aria-hidden="true">★</span> 5,0 von 5 bei ProvenExpert</span>
          <span>20+ Jahre Luxusreisen</span>
          <span>1 fester Ansprechpartner</span>
        </p>
      </form>
    </div>
  </div>
</section>

<!-- ============ KURZFAKTEN ============ -->
<section class="sec sec-stone" style="padding-block:clamp(2.5rem,5vw,3.5rem)" aria-label="Malediven auf einen Blick">
  <div class="wrap">
    <div class="info-grid">
      <div class="info">
        <p class="info-k">Flugzeit</p>
        <p class="info-v">ca. 10 Std.</p>
        <p>Direkt ab Frankfurt oder München nach Malé</p>
      </div>
      <div class="info">
        <p class="info-k">Beste Reisezeit</p>
        <p class="info-v">Jan – April</p>
        <p>Trockenzeit; Nov und Dez ebenfalls sehr gut</p>
      </div>
      <div class="info">
        <p class="info-k">Zeitverschiebung</p>
        <p class="info-v">+3 Std.</p>
        <p>Zur MEZ; im Sommer +2 Stunden</p>
      </div>
      <div class="info">
        <p class="info-k">Richtwert</p>
        <p class="info-v">ab 4.500 €</p>
        <p>P.&nbsp;P., 10 Tage mit Flug, Transfer, Halbpension</p>
      </div>
    </div>
  </div>
</section>

