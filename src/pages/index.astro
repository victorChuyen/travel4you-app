---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DestinationCard from '../components/DestinationCard.astro';
import SearchBar from '../components/SearchBar.astro';
import destinationsData from '../data/destinations.json';
import i18n from '../data/i18n.json';

const dict = i18n.en;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://travel4you.app/#website",
      "url": "https://travel4you.app/",
      "name": "Travel4You Sovereign Concierge",
      "description": "World's Most Exclusive VIP Tours, Private Charters & Sovereign Luxury Sanctuaries",
      "publisher": {
        "@type": "Organization",
        "name": "Travel4You Sovereign Concierge",
        "url": "https://travel4you.app/"
      }
    },
    {
      "@type": "ItemList",
      "itemListElement": destinationsData.map((dest, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": dest.english_title,
        "url": `https://travel4you.app/experience/${dest.slugs.en}/`
      }))
    }
  ]
};
---

<Layout
  title="Travel4You Sovereign Concierge | World's Top VIP Tours & Charters"
  description="Discover curated private Seine dinner cruises, Colosseum underground vaults, Como wooden yachts, and Kyoto tea ceremonies with 24h free cancellation."
  locale="en"
  schema={schemaData}
>
  <Header currentLocale="en" />

  <main class="flex-grow">
    
    <!-- 👑 HERO SECTION (GYG INSPIRED LUXURY REDESIGN) -->
    <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden py-24 px-4 sm:px-6 lg:px-8">
      
      <!-- Background 4K Atmosphere -->
      <div class="absolute inset-0 z-0">
        <img
          src="/media/GYG_FR_PARIS_seine-river-gourmet-dinner-cruise-bateaux-parisiens_sunset-eiffel-landscape-4k.jpg"
          alt="Paris Eiffel Tower Sunset VIP Cruise"
          class="w-full h-full object-cover object-center brightness-[0.30] scale-105 transform animate-pulse duration-[12000ms]"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#07111e]/85 via-[#07111e]/70 to-[#07111e]"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center w-full">
        
        <!-- Trust Badges -->
        <div class="inline-flex flex-wrap items-center justify-center gap-3 mb-8">
          <span class="bg-[#c9a54e]/20 border border-[#c9a54e]/50 text-[#c9a54e] text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full backdrop-blur-md shadow-lg">
            👑 2026 Gold List Curators
          </span>
          <span class="bg-slate-900/80 border border-slate-700 text-slate-300 text-xs font-medium px-4 py-1.5 rounded-full backdrop-blur-md">
            ⚡ Verified by 12,500+ Traveler Reviews
          </span>
          <span class="bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 text-xs font-semibold px-4 py-1.5 rounded-full backdrop-blur-md">
            ✓ 100% Free 24h Cancellation
          </span>
        </div>

        <!-- Headline (Inspired by GetYourGuide "Experiences worth traveling for") -->
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-[1.15] mb-6">
          Sovereign Experiences <span class="bg-gradient-to-r from-[#c9a54e] via-[#dfba63] to-[#ff7043] bg-clip-text text-transparent">Worth Traveling For</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg md:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed mb-10">
          Skip tourist crowds, unlock private palace gates, and embark on handcrafted private launches. An authoritative global index of peerless VIP journeys across 10 sovereign destinations.
        </p>

        <!-- 🔍 FLOATING SEARCH BAR & CATEGORY PILLS -->
        <SearchBar currentLocale="en" />

      </div>

    </section>


    <!-- 💎 10 GOLD LIST FLAGSHIP DESTINATIONS -->
    <section id="experiences" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <span class="text-xs font-bold text-[#c9a54e] uppercase tracking-[0.2em] block mb-2">
            The 2026 Collection
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight">
            Curated Experiences of a Lifetime
          </h2>
        </div>
        <p class="text-sm text-slate-400 max-w-md">
          Each destination is rigorously audited for private fast-track access, verified master guides, and flexible 24h cancellation terms.
        </p>
      </div>

      <!-- Empty Search State -->
      <div id="no-search-results-msg" style="display: none;" class="text-center py-16 px-4 bg-[#0b1726]/60 border border-slate-800 rounded-3xl mb-8">
        <span class="text-4xl mb-3 block">🔍</span>
        <h3 class="font-serif text-xl font-bold text-white mb-2">No Matching VIP Experiences Found</h3>
        <p class="text-xs text-slate-400 max-w-md mx-auto">
          Try searching for "Paris", "Rome", "Kyoto", "Yacht", or click "All Experiences" above to view our complete collection.
        </p>
      </div>

      <!-- Destination Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="destinations-grid-container">
        {destinationsData.map((dest) => (
          <DestinationCard
            title={dest.english_title}
            slug={dest.slugs.en}
            location={dest.location}
            image={dest.hero_image}
            rating={dest.rating}
            price={dest.price_display}
            gygLink={dest.gyg_direct_link}
            locale="en"
            region={(dest as any).region || (dest.location.includes('Japan') ? 'Asia' : dest.location.includes('Maldives') ? 'Islands' : dest.location.includes('Serengeti') ? 'Safari' : dest.location.includes('Dubai') ? 'Middle East' : 'Europe')}
            category={(dest as any).category || 'VIP Luxury Experience'}
          />
        ))}
      </div>

    </section>


    <!-- 🛡️ SOVEREIGN AUTHORITY PILLARS -->
    <section id="curator" class="py-20 bg-[#040a12] border-y border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-bold text-[#c9a54e] uppercase tracking-[0.2em] block mb-2">
            The Connoisseur Standard
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">
            Why Discerning Voyagers Book Through Travel4You
          </h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            We reject mass tourism and crowded coach excursions. Every itinerary featured in our catalog adheres to four non-negotiable sovereign principles.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          
          <div class="bg-[#07111e] border border-slate-800 p-6 rounded-2xl">
            <div class="w-12 h-12 rounded-xl bg-[#c9a54e]/10 border border-[#c9a54e]/30 flex items-center justify-center text-xl text-[#c9a54e] mb-5">
              ⚡
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Priority VIP Gates</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Bypass hours of sun-drenched queues. Step directly through dedicated security portals into restricted architectural sectors.
            </p>
          </div>

          <div class="bg-[#07111e] border border-slate-800 p-6 rounded-2xl">
            <div class="w-12 h-12 rounded-xl bg-[#ff7043]/10 border border-[#ff7043]/30 flex items-center justify-center text-xl text-[#ff7043] mb-5">
              🛥️
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Private Wooden Charters</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Glide across Lake Como or the Venice Grand Canal aboard handcrafted mahogany launches with dedicated captains and sommelier champagne.
            </p>
          </div>

          <div class="bg-[#07111e] border border-slate-800 p-6 rounded-2xl">
            <div class="w-12 h-12 rounded-xl bg-[#dfba63]/10 border border-[#dfba63]/30 flex items-center justify-center text-xl text-[#dfba63] mb-5">
              📜
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Master Docent Guides</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Experience the Vatican, Colosseum, and Louvre through licensed historians and architectural connoisseurs who unravel authentic provenance.
            </p>
          </div>

          <div class="bg-[#07111e] border border-slate-800 p-6 rounded-2xl">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-xl text-emerald-400 mb-5">
              🛡️
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">24h Free Cancellation</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Travel plans change. Enjoy 100% unconditional cash refunds up to 24 hours prior to departure on every journey.
            </p>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer currentLocale="en" />
</Layout>
