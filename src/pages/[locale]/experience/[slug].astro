---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ActionBar from '../../../components/ActionBar.astro';
import YouTubeReview from '../../../components/YouTubeReview.astro';
import articlesData from '../../../data/articles.json';

export async function getStaticPaths() {
  const nonEnArticles = (articlesData as any[]).filter(art => art.locale !== 'en');
  return nonEnArticles.map(article => ({
    params: { locale: article.locale, slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const locale = article.locale;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristAttraction",
      "@id": `https://travel4you.app/${locale}/experience/${article.slug}/#attraction`,
      "name": article.title,
      "description": article.excerpt,
      "image": `https://travel4you.app${article.hero_image?.url || '/media/' + article.hero_image?.filename}`,
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "12500"
      },
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "price": "42.00",
        "url": article.affiliate?.gyg_direct_link || `https://travel4you.app/go/${article.post_code.toLowerCase()}`,
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "GetYourGuide",
          "url": "https://www.getyourguide.com"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `https://travel4you.app/${locale}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": article.location,
          "item": `https://travel4you.app/${locale}/#experiences`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": `https://travel4you.app/${locale}/experience/${article.slug}/`
        }
      ]
    }
  ]
};
---

<Layout
  title={`${article.title} | Travel4You Concierge`}
  description={article.excerpt}
  locale={locale}
  image={article.hero_image?.url}
  schema={schemaData}
>
  <Header currentLocale={locale} />

  <main class="flex-grow pb-24">
    
    <!-- Hero Article Header -->
    <header class="relative py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-[#0b1726] to-[#07111e] border-b border-slate-800">
      <div class="max-w-4xl mx-auto text-center">
        
        <div class="inline-flex items-center space-x-2 text-xs font-bold text-[#c9a54e] uppercase tracking-widest bg-[#c9a54e]/10 border border-[#c9a54e]/30 px-3.5 py-1 rounded-full mb-6">
          <span>📍</span>
          <span>{article.location}</span>
          <span class="text-slate-500">•</span>
          <span class="text-amber-400">★ {article.affiliate?.rating}</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight mb-6">
          {article.title}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl mx-auto mb-8">
          {article.excerpt}
        </p>

        <!-- CTA Bar -->
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href={article.affiliate?.gyg_direct_link}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="bg-[#ff7043] hover:bg-[#f4511e] text-white font-bold text-sm uppercase tracking-wider px-8 py-3.5 rounded-xl shadow-lg shadow-[#ff7043]/30 transition-all duration-300"
          >
            GetYourGuide VIP Booking →
          </a>
          <span class="text-xs text-slate-400 flex items-center space-x-1">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>24h Free Cancellation Guarantee</span>
          </span>
        </div>

      </div>
    </header>

    <!-- Main Editorial Content -->
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      
      <!-- Action Bar: Bookmark, Like, Share -->
      <ActionBar
        slug={article.slug}
        title={article.title}
        gygLink={article.affiliate?.gyg_direct_link}
        locale={locale}
      />

      {article.hero_image && (
        <div class="mb-12 rounded-2xl overflow-hidden shadow-2xl border border-slate-800">
          <img
            src={article.hero_image.url}
            alt={article.title}
            class="w-full h-auto object-cover max-h-[550px]"
          />
        </div>
      )}

      <!-- Body Content Rendered from Verified Grade A Multilingual HTML -->
      <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-white prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-[#c9a54e] prose-a:underline hover:prose-a:text-[#dfba63] prose-strong:text-white prose-table:border-collapse prose-th:bg-[#07111e] prose-th:text-white prose-td:border-slate-800 prose-td:text-slate-300" set:html={article.html} />

      <!-- 🎬 YouTube 4K Video Review & Authentic Walkthrough -->
      <YouTubeReview
        postCode={article.post_code}
        location={article.location}
        title={article.title}
        locale={locale}
      />

    </article>

  </main>

  <Footer currentLocale={locale} />
</Layout>
