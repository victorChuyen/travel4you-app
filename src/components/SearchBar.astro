---

<div class="w-full max-w-4xl mx-auto mb-8 sm:mb-12 relative z-30">
  <!-- GYG-Style Floating Search Bar Pill -->
  <div class="bg-[#0b1726]/95 backdrop-blur-xl border border-slate-700/80 rounded-2xl sm:rounded-full p-2 sm:p-2.5 shadow-2xl shadow-black/50 transition-all duration-300 hover:border-[#c9a54e]/60 relative z-30">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-0">

      <!-- Input 1: Destination / Experience Keyword Search -->
      <div class="flex items-center flex-grow w-full px-3 sm:px-4 py-1.5 sm:py-1 relative">
        <span class="text-slate-400 text-base sm:text-lg mr-2.5 sm:mr-3 shrink-0">🔍</span>
        <input
          id="global-destination-search"
          type="text"
          placeholder={t.search}
          class="w-full bg-transparent border-none text-white placeholder-slate-400 text-xs sm:text-sm font-medium focus:outline-none focus:ring-0 pr-8 truncate"
          autocomplete="off"
          aria-label={t.search}
        />
        <!-- Quick Clear Button (X) -->
        <button
          id="search-clear-btn"
          type="button"
          class="hidden absolute right-3 text-slate-400 hover:text-white text-xs w-5 h-5 rounded-full bg-slate-800 flex items-center justify-center transition-all"
          title="Clear search"
          aria-label="Clear search"
        >
          ✕
        </button>
      </div>

      <!-- Divider (Desktop) -->
      <div class="hidden sm:block w-[1px] h-8 bg-slate-700/80 mx-1"></div>

      <!-- Dropdown 2: Date Selector (Interactive Luxury Popover) -->
      <div class="relative hidden md:block" id="date-selector-wrapper">
        <button
          type="button"
          id="search-date-trigger"
          class="flex items-center px-4 py-2 text-slate-300 text-xs font-medium cursor-pointer hover:text-white transition-colors rounded-full hover:bg-slate-800/60 focus:outline-none"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="mr-2 text-sm">📅</span>
          <span id="search-date-display">{t.date}</span>
          <span class="text-[#c9a54e] ml-2 text-[10px] transition-transform duration-200" id="search-date-arrow">▼</span>
        </button>

        <!-- Floating Date Popover Modal -->
        <div
          id="search-date-dropdown"
          class="hidden absolute top-full mt-3 left-1/2 -translate-x-1/2 w-80 sm:w-96 bg-[#091424] border border-[#c9a54e]/50 rounded-2xl p-5 shadow-2xl shadow-black/95 z-[99] backdrop-blur-2xl animate-fadeIn"
        >
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
            <h4 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span>📅</span> <span>{popover.dateHeading}</span>
            </h4>
            <button type="button" id="close-date-dropdown" class="text-slate-400 hover:text-white text-xs w-6 h-6 flex items-center justify-center rounded-full hover:bg-slate-800">✕</button>
          </div>

          <!-- Quick Seasons Buttons -->
          <div class="mb-4">
            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-2">{popover.seasons}</span>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" class="quick-season-btn text-left p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-[#c9a54e] text-xs text-slate-300 hover:text-white transition" data-season="autumn" data-dates="15 Oct - 25 Oct 2026">
                <span class="font-bold text-[#c9a54e] block text-xs">🍂 {popover.autumn}</span>
                <span class="text-[10px] text-slate-400">15 Oct - 25 Oct 2026</span>
              </button>
              <button type="button" class="quick-season-btn text-left p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-[#c9a54e] text-xs text-slate-300 hover:text-white transition" data-season="winter" data-dates="20 Dec - 02 Jan 2027">
                <span class="font-bold text-[#c9a54e] block text-xs">❄️ {popover.winter}</span>
                <span class="text-[10px] text-slate-400">20 Dec - 02 Jan 2027</span>
              </button>
              <button type="button" class="quick-season-btn text-left p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-[#c9a54e] text-xs text-slate-300 hover:text-white transition" data-season="spring" data-dates="25 Mar - 05 Apr 2027">
                <span class="font-bold text-[#c9a54e] block text-xs">🌸 {popover.spring}</span>
                <span class="text-[10px] text-slate-400">25 Mar - 05 Apr 2027</span>
              </button>
              <button type="button" class="quick-season-btn text-left p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-[#c9a54e] text-xs text-slate-300 hover:text-white transition" data-season="summer" data-dates="15 Jun - 25 Jun 2027">
                <span class="font-bold text-[#c9a54e] block text-xs">☀️ {popover.summer}</span>
                <span class="text-[10px] text-slate-400">15 Jun - 25 Jun 2027</span>
              </button>
            </div>
          </div>

          <!-- Specific Dates Pickers -->
          <div class="mb-4">
            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-2">{popover.chooseDates}</span>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="input-checkin-date" class="block text-[10px] text-slate-400 mb-1">Check-in</label>
                <input type="date" id="input-checkin-date" class="w-full bg-slate-900 border border-slate-700 focus:border-[#c9a54e] rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none" />
              </div>
              <div>
                <label for="input-checkout-date" class="block text-[10px] text-slate-400 mb-1">Check-out</label>
                <input type="date" id="input-checkout-date" class="w-full bg-slate-900 border border-slate-700 focus:border-[#c9a54e] rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none" />
              </div>
            </div>
          </div>

          <!-- Action Footer -->
          <div class="flex items-center justify-between pt-3 border-t border-slate-800 text-xs">
            <button type="button" id="reset-date-btn" class="text-slate-400 hover:text-white font-medium">{popover.anyDate}</button>
            <button type="button" id="apply-date-btn" class="px-5 py-2 rounded-xl bg-gradient-to-r from-[#c9a54e] to-[#a88230] text-slate-950 font-bold hover:brightness-110 transition shadow-lg shadow-[#c9a54e]/20">{popover.apply}</button>
