            <!-- Children -->
            <div class="flex items-center justify-between">
              <div>
                <span class="font-bold text-white block text-xs">{popover.children}</span>
                <span class="text-[10px] text-slate-400">{popover.childrenHint}</span>
              </div>
              <div class="flex items-center gap-3 bg-slate-900 border border-slate-800 px-2 py-1 rounded-lg">
                <button type="button" id="btn-children-minus" class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition font-bold">-</button>
                <span id="val-children" class="font-bold text-white text-sm w-4 text-center">0</span>
                <button type="button" id="btn-children-plus" class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition font-bold">+</button>
              </div>
            </div>

            <!-- Suites / Rooms -->
            <div class="flex items-center justify-between">
              <div>
                <span class="font-bold text-white block text-xs">{popover.rooms}</span>
                <span class="text-[10px] text-slate-400">Suites, Royal Villas</span>
              </div>
              <div class="flex items-center gap-3 bg-slate-900 border border-slate-800 px-2 py-1 rounded-lg">
                <button type="button" id="btn-rooms-minus" class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition font-bold">-</button>
                <span id="val-rooms" class="font-bold text-white text-sm w-4 text-center">1</span>
                <button type="button" id="btn-rooms-plus" class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition font-bold">+</button>
              </div>
            </div>
          </div>

          <!-- Action Footer -->
          <div class="flex items-center justify-between pt-3 border-t border-slate-800 text-xs">
            <button type="button" id="reset-guests-btn" class="text-slate-400 hover:text-white font-medium">{popover.defaultGuests}</button>
            <button type="button" id="apply-guests-btn" class="px-5 py-2 rounded-xl bg-gradient-to-r from-[#c9a54e] to-[#a88230] text-slate-950 font-bold hover:brightness-110 transition shadow-lg shadow-[#c9a54e]/20">{popover.apply}</button>
          </div>
        </div>
      </div>

      <!-- Search Action Button -->
      <button
        id="search-trigger-btn"
        type="button"
        class="w-full sm:w-auto bg-gradient-to-r from-[#ff7043] to-[#f4511e] hover:from-[#f4511e] hover:to-[#e64a19] text-white font-bold text-xs sm:text-sm uppercase tracking-wider px-6 sm:px-7 py-2.5 sm:py-3.5 rounded-xl sm:rounded-full shadow-lg shadow-[#ff7043]/30 transition-all duration-300 transform active:scale-95 flex items-center justify-center space-x-2 shrink-0"
      >
        <span>{t.btn}</span>
        <span>→</span>
      </button>

    </div>
  </div>

  <!-- Quick Category Filter Pills (10 Sovereign Categories & Regions) -->
  <!-- Mobile: Swipeable Horizontal Carousel | Desktop: Centered Wrap -->
  <div class="w-full overflow-x-auto no-scrollbar scroll-smooth pt-3 sm:pt-5 -mx-2 px-2 sm:mx-0 sm:px-0" id="category-filter-container">
    <div class="flex items-center sm:justify-center gap-1.5 sm:gap-2 min-w-max sm:min-w-0 pb-1 sm:pb-0" id="category-filter-pills">
      <button
        type="button"
        data-filter="all"
        class="filter-pill active px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#c9a54e]/20 border border-[#c9a54e] text-[#c9a54e] transition-all hover:border-[#c9a54e] shrink-0 whitespace-nowrap"
      >
        {t.all}
      </button>
      <button
        type="button"
        data-filter="europe"
        class="filter-pill px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900/80 border border-slate-700 text-slate-300 transition-all hover:border-slate-500 hover:text-white shrink-0 whitespace-nowrap"
      >
        {t.europe}
      </button>
      <button
        type="button"
        data-filter="asia"
        class="filter-pill px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900/80 border border-slate-700 text-slate-300 transition-all hover:border-slate-500 hover:text-white shrink-0 whitespace-nowrap"
      >
        {t.asia}
      </button>
      <button
        type="button"
        data-filter="islands"
        class="filter-pill px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900/80 border border-slate-700 text-slate-300 transition-all hover:border-slate-500 hover:text-white shrink-0 whitespace-nowrap"
      >
        {t.islands}
      </button>
      <button
        type="button"
        data-filter="safari"
        class="filter-pill px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900/80 border border-slate-700 text-slate-300 transition-all hover:border-slate-500 hover:text-white shrink-0 whitespace-nowrap"
      >
        {t.safari}
      </button>
      <button
        type="button"
        data-filter="me"
        class="filter-pill px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900/80 border border-slate-700 text-slate-300 transition-all hover:border-slate-500 hover:text-white shrink-0 whitespace-nowrap"
      >
        {t.me}
      </button>
      <button
        type="button"
        data-filter="wellness"
        class="filter-pill px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900/80 border border-slate-700 text-slate-300 transition-all hover:border-slate-500 hover:text-white shrink-0 whitespace-nowrap"
      >
        {t.wellness}
      </button>
      <button
        type="button"
        data-filter="hotels"
        class="filter-pill px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900/80 border border-slate-700 text-slate-300 transition-all hover:border-slate-500 hover:text-white shrink-0 whitespace-nowrap"
      >
        {t.hotels}
      </button>
    </div>
  </div>

  <!-- Search Results Counter Status -->
  <div id="search-status-counter" class="text-center text-xs text-slate-400 mt-4 hidden" role="status" aria-live="polite">
    <span class="text-[#c9a54e] font-bold" id="counter-number">0</span>
    <span id="counter-label"> {t.found}</span>
  </div>
</div>

<script is:inline>
  function setup1000SearchAndFilters() {
    const searchInput = document.getElementById('global-destination-search');
    const clearBtn = document.getElementById('search-clear-btn');
    const searchBtn = document.getElementById('search-trigger-btn');
    const pills = document.querySelectorAll('.filter-pill');
    const container = document.getElementById('destinations-grid-container');
    const counterBox = document.getElementById('search-status-counter');
    const counterNum = document.getElementById('counter-number');
    const noResultsEl = document.getElementById('no-search-results-msg');

    let fullIndex = null;
    const initialHtml = container ? container.innerHTML : '';
    let activeFilter = 'all';
    let searchQuery = '';
    let currentRenderCount = 24;
    let currentFilteredList = [];
    let debounceTimer = null;

    // Detect current locale accurately from URL pathname
    function detectLocale() {
      const parts = window.location.pathname.split('/').filter(Boolean);
      if (parts.length > 0) {
        const first = parts[0];
        const supported = ['vi', 'de', 'fr', 'es', 'it', 'ja', 'ko', 'zh-tw', 'zh-cn', 'pt', 'ru'];
        if (supported.includes(first)) return first;
      }
      return 'en';
    }

    const currentLocale = detectLocale();
    const isVietnamese = currentLocale === 'vi';
    const fallbackImage = '/media/GYG_FR_PARIS_seine-river-gourmet-dinner-cruise-bateaux-parisiens_sunset-eiffel-landscape-4k.jpg';

    // Lazy load 1000 search index with caching
    async function loadIndex() {
      if (fullIndex) return fullIndex;
      try {
        const res = await fetch('/data/destinations_search_index.json');
        if (res.ok) {
          fullIndex = await res.json();
          return fullIndex;
        }
      } catch (e) {
        console.warn('Could not load 1000 search index:', e);
      }
      return null;
    }

    function createCardHtml(item, index = 0) {
      const gygUrl = window.getAttributedGygUrl ? window.getAttributedGygUrl(item.u) : item.u;
      let detailUrl = item.d
        ? (currentLocale === 'en' ? `/experience/${item.k}/` : `/${currentLocale}/experience/${item.k}/`)
        : gygUrl;
      const bookingParams = window.t4uGetBookingParams ? window.t4uGetBookingParams() : '';
      if (bookingParams) {
        detailUrl += (detailUrl.includes('?') ? '&' : '?') + bookingParams;
      }
      const ctaText = item.d ? (isVietnamese ? 'Xem Cẩm Nang' : 'Read Guide') : (isVietnamese ? 'Xem Giá Phòng' : 'Check Rates');

      let isSaved = false;
      try {
        const saved = JSON.parse(localStorage.getItem('t4u_bookmarks') || '[]');
        isSaved = saved.includes(item.k);
      } catch (e) {
        isSaved = false;
      }

      const isAboveFold = index < 12;
      const loadingAttr = isAboveFold ? 'loading="eager"' : 'loading="lazy"';
      const fetchPriorityAttr = index < 3 ? 'fetchpriority="high"' : '';

      return `
        <div
          class="destination-card-item group bg-[#0b1726] border border-slate-800 rounded-2xl overflow-hidden hover:border-[#c9a54e]/60 transition-all duration-300 hover:shadow-2xl hover:shadow-[#c9a54e]/10 flex flex-col h-full relative animate-fadeIn"
          data-title="${item.t}"
          data-location="${item.l}"
          data-region="${item.r}"
          data-category="${item.c}"
        >
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-900">
            <img
              src="${item.m}"
              alt="${item.t}"
              ${loadingAttr}
              ${fetchPriorityAttr}
              onerror="this.onerror=null;this.src='${fallbackImage}'"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b1726] via-transparent to-black/40"></div>

            <div class="absolute top-3.5 left-3.5 flex items-center space-x-2">
              <span class="bg-[#07111e]/90 backdrop-blur-md text-[#c9a54e] text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-[#c9a54e]/30 shadow-md">
                ${item.l}
              </span>
            </div>

            <div class="absolute top-3.5 right-3.5 flex items-center space-x-1.5 z-10">
              <button
                type="button"
                class="bookmark-btn w-8 h-8 rounded-full bg-[#07111e]/90 backdrop-blur-md border border-slate-700 ${isSaved ? 'text-rose-500 border-rose-500/60' : 'text-slate-300'} hover:text-rose-500 hover:border-red-500/50 flex items-center justify-center transition-all shadow-md focus:outline-none"
                data-slug="${item.k}"
                title="Bookmark this experience"
                aria-label="Bookmark"
              >
                <svg class="heart-icon w-4 h-4" fill="${isSaved ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
              </button>

              <button
                type="button"
                class="card-share-btn w-8 h-8 rounded-full bg-[#07111e]/90 backdrop-blur-md border border-slate-700 text-slate-300 hover:text-[#c9a54e] hover:border-[#c9a54e]/50 flex items-center justify-center transition-all shadow-md focus:outline-none"
                data-url="${detailUrl}"
                data-title="${item.t}"
                title="Share"
                aria-label="Share"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                </svg>
              </button>
            </div>

            <div class="absolute bottom-3 left-3.5">
              <span class="text-[10px] text-slate-300 block uppercase tracking-wider font-medium">${isVietnamese ? 'Khởi điểm' : 'Starting from'}</span>
              <span class="text-base font-bold text-white font-serif">${item.g}</span>
            </div>

            <div class="absolute bottom-3 right-3.5 flex items-center space-x-2">
              <span class="bg-[#07111e]/90 backdrop-blur-md text-amber-400 text-xs font-semibold px-2.5 py-1 rounded-full border border-slate-700 shadow-md flex items-center space-x-1">
                <span>★</span>
                <span>${item.s}</span>
              </span>
            </div>
          </div>

          <div class="p-5 flex flex-col flex-grow justify-between">
            <div>
              <span class="text-[10px] text-[#c9a54e] font-bold uppercase tracking-wider block mb-1">
                ${item.c}
              </span>
              <h3 class="font-serif text-base sm:text-lg font-bold text-white group-hover:text-[#c9a54e] transition-colors leading-snug mb-2 line-clamp-2">
                <a href="${detailUrl}" ${item.d ? '' : 'target="_blank" rel="nofollow sponsored noopener"'}>
                  ${item.t}
                </a>
              </h3>
            </div>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
              ${item.d ? `
                <a href="${detailUrl}" class="text-xs font-bold text-slate-300 hover:text-[#c9a54e] flex items-center space-x-1 transition-colors">
                  <span>${ctaText}</span>
                  <span>→</span>
                </a>
              ` : `
                <span class="text-[11px] text-slate-400 font-medium">Expedia Partner Verified</span>
              `}

              <a
                href="${item.u}"
                target="_blank"
                rel="nofollow sponsored noopener"
                class="bg-gradient-to-r from-[#c9a54e] to-[#dfba63] hover:from-[#dfba63] hover:to-[#e8c878] text-[#07111e] text-xs font-bold px-4 py-2 rounded-xl shadow-md transition-all text-center flex items-center space-x-1"
              >
                <span>${isVietnamese ? 'Xem Giá Phòng' : 'Check Rates'}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      `;
    }

    function renderCardsWithPagination() {
      if (!container) return;

      const toRender = currentFilteredList.slice(0, currentRenderCount);

      if (toRender.length === 0) {
        container.innerHTML = '';
        if (noResultsEl) noResultsEl.style.display = 'block';
        removeLoadMoreBtn();
      } else {
        if (noResultsEl) noResultsEl.style.display = 'none';
        container.innerHTML = toRender.map((item, idx) => createCardHtml(item, idx)).join('');

        // Render or update Load More Button
        if (currentFilteredList.length > currentRenderCount) {
          renderLoadMoreBtn(currentFilteredList.length);
        } else {
          removeLoadMoreBtn();
        }

        // Trigger layout scroll event
        try {
          window.dispatchEvent(new Event('scroll'));
        } catch (e) {}
      }

      if (window.initBookmarks) window.initBookmarks();
    }

    function renderLoadMoreBtn(total) {
      let loadMoreContainer = document.getElementById('load-more-container');
      if (!loadMoreContainer) {
        loadMoreContainer = document.createElement('div');
        loadMoreContainer.id = 'load-more-container';
        loadMoreContainer.className = 'col-span-full text-center py-10 flex flex-col items-center gap-2';
        container.parentNode.appendChild(loadMoreContainer);
      }

      const btnText = isVietnamese
        ? `Khám Phá Thêm (${currentRenderCount}/${total}) ↓`
        : `Load More Sanctuaries (Showing ${currentRenderCount} of ${total}) ↓`;

      loadMoreContainer.innerHTML = `
        <button
          id="load-more-experiences-btn"
          type="button"
          class="bg-slate-900 hover:bg-[#0b1726] text-slate-200 hover:text-white border border-[#c9a54e]/50 hover:border-[#c9a54e] font-semibold text-xs sm:text-sm px-8 py-3.5 rounded-full shadow-lg transition-all duration-300 transform active:scale-95"
        >
          ${btnText}
        </button>
      `;

      const btn = document.getElementById('load-more-experiences-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          currentRenderCount += 24;
          renderCardsWithPagination();
        });
      }
    }

    function removeLoadMoreBtn() {
      const el = document.getElementById('load-more-container');
      if (el) el.remove();
    }

    async function applyFilters() {
      // Toggle clear button
      if (clearBtn) {
        clearBtn.style.display = searchQuery ? 'flex' : 'none';
      }

      // If no query and filter is 'all', restore initial curated cards
      if (!searchQuery && activeFilter === 'all') {
        if (container) container.innerHTML = initialHtml;
        if (noResultsEl) noResultsEl.style.display = 'none';
        if (counterBox) counterBox.classList.add('hidden');
        removeLoadMoreBtn();
        if (window.initBookmarks) window.initBookmarks();
        return;
      }

      const index = await loadIndex();
      if (!index) return;

      currentFilteredList = index.filter(item => {
        const text = ((item.t || '') + ' ' + (item.l || '') + ' ' + (item.c || '')).toLowerCase();
        const matchesSearch = !searchQuery || text.includes(searchQuery);

        let matchesFilter = true;
        const regionLower = (item.r || '').toLowerCase();
        const locLower = (item.l || '').toLowerCase();
        const catLower = (item.c || '').toLowerCase();
        const titleLower = (item.t || '').toLowerCase();

        if (activeFilter === 'europe') {
          matchesFilter = regionLower.includes('europe') || regionLower.includes('palace') || locLower.includes('italy') || locLower.includes('france') || locLower.includes('swiss') || locLower.includes('greece') || locLower.includes('portugal') || locLower.includes('spain') || locLower.includes('monaco') || locLower.includes('paris') || locLower.includes('rome') || locLower.includes('como') || locLower.includes('venice') || locLower.includes('london') || locLower.includes('united kingdom') || locLower.includes('ireland') || locLower.includes('amalfi') || locLower.includes('santorini') || locLower.includes('bordeaux');
        } else if (activeFilter === 'asia') {
          matchesFilter = regionLower.includes('asia') || regionLower.includes('ryokan') || locLower.includes('japan') || locLower.includes('bali') || locLower.includes('indonesia') || locLower.includes('thailand') || locLower.includes('vietnam') || locLower.includes('kyoto') || locLower.includes('tokyo') || locLower.includes('bangkok') || locLower.includes('hong kong') || locLower.includes('sri lanka') || locLower.includes('cambodia');
        } else if (activeFilter === 'islands') {
          matchesFilter = regionLower.includes('overwater') || regionLower.includes('island') || locLower.includes('maldives') || locLower.includes('seychelles') || locLower.includes('polynesia') || locLower.includes('tetiaroa') || locLower.includes('bora') || locLower.includes('fiji') || locLower.includes('hawaii') || locLower.includes('barth') || locLower.includes('atoll') || catLower.includes('island') || catLower.includes('overwater');
        } else if (activeFilter === 'safari') {
          matchesFilter = regionLower.includes('safari') || locLower.includes('serengeti') || locLower.includes('africa') || locLower.includes('tanzania') || locLower.includes('kenya') || locLower.includes('kruger') || locLower.includes('south africa') || catLower.includes('safari');
        } else if (activeFilter === 'me') {
          matchesFilter = regionLower.includes('middle east') || locLower.includes('dubai') || locLower.includes('emirates') || locLower.includes('oman') || locLower.includes('qatar') || locLower.includes('morocco') || locLower.includes('marrakech') || locLower.includes('abu dhabi');
        } else if (activeFilter === 'wellness') {
          matchesFilter = catLower.includes('wellness') || catLower.includes('spa') || catLower.includes('retreat') || titleLower.includes('spa') || titleLower.includes('onsen') || titleLower.includes('wellness') || catLower.includes('onsen') || locLower.includes('montreux') || locLower.includes('geneva') || locLower.includes('hakone');
        } else if (activeFilter === 'hotels') {
          matchesFilter = catLower.includes('palace') || catLower.includes('hotel') || catLower.includes('sanctuaries') || titleLower.includes('hotel') || titleLower.includes('palace') || titleLower.includes('resort') || titleLower.includes('château') || regionLower.includes('palace');
        }

        return matchesSearch && matchesFilter;
      });

      currentRenderCount = 24; // Reset to first batch
      if (counterBox && counterNum) {
        counterNum.textContent = currentFilteredList.length;
        counterBox.classList.remove('hidden');
      }

      renderCardsWithPagination();
    }

    // Debounced input handler
    if (searchInput) {
      searchInput.addEventListener('focus', loadIndex);
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          searchQuery = e.target.value.toLowerCase().trim();
          applyFilters();
        }, 120);
      });

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          searchQuery = searchInput.value.toLowerCase().trim();
          applyFilters();
          const target = document.getElementById('experiences') || document.getElementById('destinations-grid-container');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        applyFilters();
        if (searchInput) searchInput.focus();
      });
    }

    pills.forEach(pill => {
      pill.addEventListener('mouseenter', loadIndex);
      pill.addEventListener('click', () => {
        pills.forEach(p => {
          p.classList.remove('active', 'bg-[#c9a54e]/20', 'border-[#c9a54e]', 'text-[#c9a54e]');
          p.classList.add('bg-slate-900/80', 'border-slate-700', 'text-slate-300');
        });
        pill.classList.remove('bg-slate-900/80', 'border-slate-700', 'text-slate-300');
        pill.classList.add('active', 'bg-[#c9a54e]/20', 'border-[#c9a54e]', 'text-[#c9a54e]');

        activeFilter = pill.getAttribute('data-filter') || 'all';
        applyFilters();

        if (activeFilter !== 'all') {
          const target = document.getElementById('experiences') || document.getElementById('destinations-grid-container');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    // -------------------------------------------------------------
    // INTERACTIVE DATE PICKER & GUESTS SELECTOR LOGIC
    // -------------------------------------------------------------
    let selectedDates = { checkin: '', checkout: '', display: '' };
    let selectedGuests = { adults: 2, children: 0, rooms: 1, display: '' };

    // DOM Elements - Date
    const dateTrigger = document.getElementById('search-date-trigger');
    const dateDropdown = document.getElementById('search-date-dropdown');
    const dateDisplay = document.getElementById('search-date-display');
    const dateArrow = document.getElementById('search-date-arrow');
    const closeDateBtn = document.getElementById('close-date-dropdown');
    const quickSeasonBtns = document.querySelectorAll('.quick-season-btn');
    const inputCheckin = document.getElementById('input-checkin-date');
    const inputCheckout = document.getElementById('input-checkout-date');
    const applyDateBtn = document.getElementById('apply-date-btn');
    const resetDateBtn = document.getElementById('reset-date-btn');

    // DOM Elements - Guests
    const guestsTrigger = document.getElementById('search-guests-trigger');
    const guestsDropdown = document.getElementById('search-guests-dropdown');
    const guestsDisplay = document.getElementById('search-guests-display');
    const guestsArrow = document.getElementById('search-guests-arrow');
    const closeGuestsBtn = document.getElementById('close-guests-dropdown');
    const applyGuestsBtn = document.getElementById('apply-guests-btn');
    const resetGuestsBtn = document.getElementById('reset-guests-btn');

    const valAdults = document.getElementById('val-adults');
    const btnAdultsMinus = document.getElementById('btn-adults-minus');
    const btnAdultsPlus = document.getElementById('btn-adults-plus');

    const valChildren = document.getElementById('val-children');
    const btnChildrenMinus = document.getElementById('btn-children-minus');
    const btnChildrenPlus = document.getElementById('btn-children-plus');

    const valRooms = document.getElementById('val-rooms');
    const btnRoomsMinus = document.getElementById('btn-rooms-minus');
    const btnRoomsPlus = document.getElementById('btn-rooms-plus');

    let curAdults = 2;
    let curChildren = 0;
    let curRooms = 1;

    // Toast helper
    function showFilterToast(msg) {
      let toast = document.getElementById('search-filter-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'search-filter-toast';
        toast.className = 'fixed bottom-6 right-6 z-50 bg-[#07111e]/95 border border-[#c9a54e] text-white text-xs font-semibold px-5 py-3.5 rounded-2xl shadow-2xl shadow-black/80 flex items-center gap-3 transform transition-all duration-300 opacity-0 translate-y-4';
        document.body.appendChild(toast);
      }
      toast.innerHTML = `<span class="text-[#c9a54e] text-lg">✨</span> <span class="leading-tight">${msg}</span>`;
      toast.classList.remove('opacity-0', 'translate-y-4');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-4');
      }, 3500);
    }

    function toggleDateDropdown(open) {
      if (!dateDropdown) return;
      const isOpen = open !== undefined ? open : dateDropdown.classList.contains('hidden');
      if (isOpen) {
        dateDropdown.classList.remove('hidden');
        if (dateTrigger) dateTrigger.setAttribute('aria-expanded', 'true');
        if (dateArrow) dateArrow.style.transform = 'rotate(180deg)';
        toggleGuestsDropdown(false);
      } else {
        dateDropdown.classList.add('hidden');
        if (dateTrigger) dateTrigger.setAttribute('aria-expanded', 'false');
        if (dateArrow) dateArrow.style.transform = 'rotate(0deg)';
      }
    }

    function toggleGuestsDropdown(open) {
      if (!guestsDropdown) return;
      const isOpen = open !== undefined ? open : guestsDropdown.classList.contains('hidden');
      if (isOpen) {
        guestsDropdown.classList.remove('hidden');
        if (guestsTrigger) guestsTrigger.setAttribute('aria-expanded', 'true');
        if (guestsArrow) guestsArrow.style.transform = 'rotate(180deg)';
        toggleDateDropdown(false);
      } else {
        guestsDropdown.classList.add('hidden');
        if (guestsTrigger) guestsTrigger.setAttribute('aria-expanded', 'false');
        if (guestsArrow) guestsArrow.style.transform = 'rotate(0deg)';
      }
    }

    if (dateTrigger) {
      dateTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDateDropdown();
      });
    }

    if (guestsTrigger) {
      guestsTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleGuestsDropdown();
      });
    }

    if (closeDateBtn) closeDateBtn.addEventListener('click', () => toggleDateDropdown(false));
    if (closeGuestsBtn) closeGuestsBtn.addEventListener('click', () => toggleGuestsDropdown(false));

    // Stop propagation so clicking inside forms does not close them
    if (dateDropdown) dateDropdown.addEventListener('click', (e) => e.stopPropagation());
    if (guestsDropdown) guestsDropdown.addEventListener('click', (e) => e.stopPropagation());

    // Click outside to close both
    document.addEventListener('click', () => {
      toggleDateDropdown(false);
      toggleGuestsDropdown(false);
    });

    // Quick season picks
    quickSeasonBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const dates = btn.getAttribute('data-dates') || '';
        const seasonName = btn.querySelector('.font-bold')?.textContent || dates;
        selectedDates.display = seasonName;
        selectedDates.checkin = dates.split(' - ')[0] || '';
        selectedDates.checkout = dates.split(' - ')[1] || '';
        if (dateDisplay) {
          dateDisplay.textContent = seasonName;
          dateDisplay.classList.add('text-[#c9a54e]', 'font-bold');
        }
        toggleDateDropdown(false);
        showFilterToast(isVietnamese ? `Đã chọn lịch trình: ${seasonName} (${dates})` : `Selected Season: ${seasonName} (${dates})`);
      });
    });

    // Custom dates apply
    if (applyDateBtn) {
      applyDateBtn.addEventListener('click', () => {
        const inVal = inputCheckin?.value;
        const outVal = inputCheckout?.value;
        if (inVal && outVal) {
          const display = `${inVal.slice(5)} → ${outVal.slice(5)}`;
          selectedDates.checkin = inVal;
          selectedDates.checkout = outVal;
          selectedDates.display = display;
          if (dateDisplay) {
            dateDisplay.textContent = display;
            dateDisplay.classList.add('text-[#c9a54e]', 'font-bold');
          }
          showFilterToast(isVietnamese ? `Đã chọn ngày: ${inVal} đến ${outVal}` : `Selected Dates: ${inVal} to ${outVal}`);
        }
        toggleDateDropdown(false);
      });
    }

    // Date reset
    if (resetDateBtn) {
      resetDateBtn.addEventListener('click', () => {
        selectedDates = { checkin: '', checkout: '', display: '' };
        if (dateDisplay) {
          dateDisplay.textContent = isVietnamese ? 'Thời gian: Bất kỳ' : 'Anytime';
          dateDisplay.classList.remove('text-[#c9a54e]', 'font-bold');
        }
        if (inputCheckin) inputCheckin.value = '';
        if (inputCheckout) inputCheckout.value = '';
        toggleDateDropdown(false);
        showFilterToast(isVietnamese ? 'Đã đặt lại: Bất kỳ ngày nào' : 'Reset to: Anytime');
      });
    }

    // Guests +/- controls
    function updateGuestsUI() {
      if (valAdults) valAdults.textContent = curAdults;
      if (valChildren) valChildren.textContent = curChildren;
      if (valRooms) valRooms.textContent = curRooms;
    }

    if (btnAdultsMinus) btnAdultsMinus.addEventListener('click', () => {
      if (curAdults > 1) { curAdults--; updateGuestsUI(); }
    });
    if (btnAdultsPlus) btnAdultsPlus.addEventListener('click', () => {
      if (curAdults < 10) { curAdults++; updateGuestsUI(); }
    });

    if (btnChildrenMinus) btnChildrenMinus.addEventListener('click', () => {
      if (curChildren > 0) { curChildren--; updateGuestsUI(); }
    });
    if (btnChildrenPlus) btnChildrenPlus.addEventListener('click', () => {
      if (curChildren < 8) { curChildren++; updateGuestsUI(); }
    });

    if (btnRoomsMinus) btnRoomsMinus.addEventListener('click', () => {
      if (curRooms > 1) { curRooms--; updateGuestsUI(); }
    });
    if (btnRoomsPlus) btnRoomsPlus.addEventListener('click', () => {
      if (curRooms < 6) { curRooms++; updateGuestsUI(); }
    });

    // Apply Guests
    if (applyGuestsBtn) {
      applyGuestsBtn.addEventListener('click', () => {
        selectedGuests.adults = curAdults;
        selectedGuests.children = curChildren;
        selectedGuests.rooms = curRooms;
        const totalGuests = curAdults + curChildren;
        const label = isVietnamese
          ? `${totalGuests} Khách, ${curRooms} Phòng`
          : `${totalGuests} Guests, ${curRooms} Suite${curRooms > 1 ? 's' : ''}`;
        selectedGuests.display = label;
        if (guestsDisplay) {
          guestsDisplay.textContent = label;
          guestsDisplay.classList.add('text-[#c9a54e]', 'font-bold');
        }
        toggleGuestsDropdown(false);
        showFilterToast(isVietnamese ? `Đã chọn: ${label}` : `Selected: ${label}`);
      });
    }

    // Reset Guests
    if (resetGuestsBtn) {
      resetGuestsBtn.addEventListener('click', () => {
        curAdults = 2;
        curChildren = 0;
        curRooms = 1;
        updateGuestsUI();
        selectedGuests = { adults: 2, children: 0, rooms: 1, display: '' };
        if (guestsDisplay) {
          guestsDisplay.textContent = isVietnamese ? '1 - 2 Khách' : '1 - 2 Guests';
          guestsDisplay.classList.remove('text-[#c9a54e]', 'font-bold');
        }
        toggleGuestsDropdown(false);
        showFilterToast(isVietnamese ? 'Đã đặt lại: 1 - 2 Khách' : 'Reset to: 1 - 2 Guests');
      });
    }

    // Expose booking query generator for cards
    window.t4uGetBookingParams = function() {
      const p = new URLSearchParams();
      if (selectedDates.checkin) p.set('checkin', selectedDates.checkin);
      if (selectedDates.checkout) p.set('checkout', selectedDates.checkout);
      if (selectedGuests.adults) p.set('adults', selectedGuests.adults);
      if (selectedGuests.children) p.set('children', selectedGuests.children);
      if (selectedGuests.rooms) p.set('rooms', selectedGuests.rooms);
      return p.toString();
    };

    if (searchBtn) {
      searchBtn.addEventListener('click', () => {
        searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : '';
        applyFilters();

        let toastMsg = [];
        if (searchQuery) toastMsg.push(`"${searchQuery}"`);
        if (selectedDates.display) toastMsg.push(selectedDates.display);
        if (selectedGuests.display) toastMsg.push(selectedGuests.display);

        if (toastMsg.length > 0) {
          showFilterToast(isVietnamese ? `Đang tìm kiếm: ${toastMsg.join(' • ')}` : `Searching for: ${toastMsg.join(' • ')}`);
        }

        const target = document.getElementById('experiences') || document.getElementById('destinations-grid-container');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // Preload index in background
    setTimeout(loadIndex, 800);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup1000SearchAndFilters);
  } else {
    setup1000SearchAndFilters();
  }
</script>
