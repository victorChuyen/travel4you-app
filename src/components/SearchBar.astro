              <div class="flex items-center gap-3 bg-slate-900 border border-slate-800 px-2 py-1 rounded-lg">
                <button type="button" id="btn-adults-minus" class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition font-bold">-</button>
                <span id="val-adults" class="font-bold text-white text-sm w-4 text-center">2</span>
                <button type="button" id="btn-adults-plus" class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition font-bold">+</button>
              </div>
