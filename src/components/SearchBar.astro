        </button>

        <!-- Floating Guests Popover Modal -->
        <div
          id="search-guests-dropdown"
          class="hidden absolute top-full mt-3 right-0 w-80 bg-[#091424] border border-[#c9a54e]/50 rounded-2xl p-5 shadow-2xl shadow-black/95 z-[99] backdrop-blur-2xl animate-fadeIn"
        >
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
