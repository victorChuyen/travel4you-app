---
interface Props {
  slug: string;
  title: string;
  gygLink: string;
  locale?: string;
}

const { slug, title, gygLink, locale = 'en' } = Astro.props;

const labels: Record<string, { save: string; liked: string; share: string; book: string }> = {
  en: {
    save: "Save to Wishlist",
    liked: "Helpful (1.8k)",
    share: "Share Experience",
    book: "Reserve VIP Pass →"
  },
  vi: {
    save: "Lưu Trải Nghiệm",
    liked: "Hữu Ích (1.8k)",
    share: "Chia Sẻ Cẩm Nang",
    book: "Đặt Vé VIP Ngay →"
  }
};

const t = labels[locale] || labels.en;
---

<div class="flex flex-wrap items-center justify-between gap-3 py-4 px-5 my-8 bg-[#0b1726]/90 border border-slate-800 rounded-2xl backdrop-blur-md">
  
  <!-- Left: Social Engagement (Save, Like, Share) -->
  <div class="flex items-center space-x-2">
    
    <!-- Bookmark Button -->
    <button
      type="button"
      class="bookmark-btn inline-flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700/80 text-xs font-semibold text-slate-300 hover:text-rose-400 hover:border-rose-500/50 transition-all shadow-sm active:scale-95"
      data-slug={slug}
    >
      <svg class="heart-icon w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
      </svg>
      <span>{t.save}</span>
    </button>

    <!-- Like Button -->
    <button
      type="button"
      id="like-action-btn"
      class="inline-flex items-center space-x-1.5 px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700/80 text-xs font-semibold text-slate-300 hover:text-[#c9a54e] hover:border-[#c9a54e]/50 transition-all shadow-sm active:scale-95"
    >
      <span>👍</span>
      <span id="like-count-text">{t.liked}</span>
    </button>

    <!-- Share Button -->
    <button
      type="button"
      class="page-share-btn inline-flex items-center space-x-1.5 px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700/80 text-xs font-semibold text-slate-300 hover:text-white hover:border-slate-500 transition-all shadow-sm active:scale-95"
      data-title={title}
    >
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
      </svg>
      <span>{t.share}</span>
    </button>

  </div>

  <!-- Right: Direct VIP Booking CTA -->
  <div class="flex items-center">
    <a
      href={gygLink}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="bg-[#ff7043] hover:bg-[#f4511e] text-white text-xs font-bold uppercase tracking-wider px-5 py-2.5 rounded-xl shadow-md shadow-[#ff7043]/20 hover:shadow-[#ff7043]/40 transition-all flex items-center space-x-1"
    >
      <span>{t.book}</span>
    </a>
  </div>

</div>

<script is:inline>
  const likeBtn = document.getElementById('like-action-btn');
  const likeText = document.getElementById('like-count-text');
  let liked = false;

  if (likeBtn && likeText) {
    likeBtn.addEventListener('click', () => {
      if (!liked) {
        liked = true;
        likeBtn.classList.add('text-[#c9a54e]', 'border-[#c9a54e]');
        likeText.textContent = 'Helpful (1.8k + 1)';
        if (window.showToast) window.showToast('Thank you for your valuable feedback!', '👍');
      } else {
        liked = false;
        likeBtn.classList.remove('text-[#c9a54e]', 'border-[#c9a54e]');
        likeText.textContent = 'Helpful (1.8k)';
      }
    });
  }
</script>
