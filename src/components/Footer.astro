---
import i18n from '../data/i18n.json';

interface Props {
  currentLocale?: string;
}

const { currentLocale = 'en' } = Astro.props;
const dict = (i18n as any)[currentLocale] || (i18n as any).en;
const isAppRoute = Astro.url.pathname.startsWith('/app');
---

<footer class="bg-[#040a12] border-t border-slate-800/80 pt-16 pb-12 text-slate-400 text-sm mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {!isAppRoute && (
      <section class="mb-12 rounded-2xl border border-[#c9a54e]/35 bg-gradient-to-br from-[#0d1b2c] to-[#07111e] p-5 sm:p-7" aria-labelledby="footer-cta-title">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(320px,480px)] lg:items-center">
          <div class="max-w-2xl">
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#c9a54e]">VIP Concierge</p>
            <h2 id="footer-cta-title" class="mt-2 font-serif text-2xl font-bold text-white sm:text-3xl">
              {currentLocale === 'vi' ? 'Để chúng tôi thiết kế chuyến đi VIP của bạn.' : 'Let us design your private VIP journey.'}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">
              {currentLocale === 'vi'
                ? 'Chia sẻ mong muốn, điểm đến và ngân sách. Đội ngũ concierge sẽ liên hệ với đề xuất phù hợp.'
                : 'Share your wishes, destination and budget. Our concierge team will follow up with a tailored proposal.'}
            </p>
          </div>
          <form id="vip-lead-form" class="grid gap-3 sm:grid-cols-2" action="/api/leads" method="post">
            <label class="sr-only" for="vip-name">{currentLocale === 'vi' ? 'Họ tên' : 'Name'}</label>
            <input id="vip-name" name="name" required maxlength="120" autocomplete="name" placeholder={currentLocale === 'vi' ? 'Họ tên *' : 'Your name *'} class="min-h-11 rounded-lg border border-slate-700 bg-slate-950/60 px-3 text-sm text-white placeholder:text-slate-500 focus:border-[#c9a54e] focus:outline-none" />
            <label class="sr-only" for="vip-email">Email</label>
            <input id="vip-email" name="email" required type="email" maxlength="254" autocomplete="email" placeholder="Email *" class="min-h-11 rounded-lg border border-slate-700 bg-slate-950/60 px-3 text-sm text-white placeholder:text-slate-500 focus:border-[#c9a54e] focus:outline-none" />
            <label class="sr-only" for="vip-phone">{currentLocale === 'vi' ? 'Số điện thoại' : 'Phone'}</label>
            <input id="vip-phone" name="phone" type="tel" maxlength="32" autocomplete="tel" placeholder={currentLocale === 'vi' ? 'Số điện thoại' : 'Phone'} class="min-h-11 rounded-lg border border-slate-700 bg-slate-950/60 px-3 text-sm text-white placeholder:text-slate-500 focus:border-[#c9a54e] focus:outline-none" />
            <label class="sr-only" for="vip-destination">{currentLocale === 'vi' ? 'Điểm đến' : 'Destination'}</label>
            <input id="vip-destination" name="destination" maxlength="160" placeholder={currentLocale === 'vi' ? 'Điểm đến mong muốn' : 'Preferred destination'} class="min-h-11 rounded-lg border border-slate-700 bg-slate-950/60 px-3 text-sm text-white placeholder:text-slate-500 focus:border-[#c9a54e] focus:outline-none" />
            <select name="request_type" required class="min-h-11 rounded-lg border border-slate-700 bg-slate-950/60 px-3 text-sm text-white focus:border-[#c9a54e] focus:outline-none">
              <option value="">{currentLocale === 'vi' ? 'Bạn cần hỗ trợ gì? *' : 'What can we arrange? *'}</option>
              <option value="private_itinerary">{currentLocale === 'vi' ? 'Lịch trình riêng' : 'Private itinerary'}</option>
              <option value="vip_experience">{currentLocale === 'vi' ? 'Trải nghiệm VIP' : 'VIP experience'}</option>
              <option value="hotel_villa">{currentLocale === 'vi' ? 'Khách sạn / villa' : 'Hotel / villa'}</option>
              <option value="other">{currentLocale === 'vi' ? 'Yêu cầu khác' : 'Other request'}</option>
            </select>
            <input name="budget" maxlength="80" placeholder={currentLocale === 'vi' ? 'Ngân sách dự kiến' : 'Estimated budget'} class="min-h-11 rounded-lg border border-slate-700 bg-slate-950/60 px-3 text-sm text-white placeholder:text-slate-500 focus:border-[#c9a54e] focus:outline-none" />
            <textarea name="message" maxlength="2000" rows="2" placeholder={currentLocale === 'vi' ? 'Mô tả ngắn yêu cầu của bạn' : 'Tell us briefly what you need'} class="sm:col-span-2 rounded-lg border border-slate-700 bg-slate-950/60 px-3 py-2 text-sm text-white placeholder:text-slate-500 focus:border-[#c9a54e] focus:outline-none"></textarea>
            <div aria-hidden="true" class="hidden"><input name="website" tabindex="-1" autocomplete="off" /></div>
            <button type="submit" class="sm:col-span-2 inline-flex min-h-11 items-center justify-center rounded-lg bg-[#c9a54e] px-5 py-3 text-sm font-bold text-[#07111e] transition hover:bg-[#e1bd63] focus:outline-none focus:ring-2 focus:ring-[#c9a54e] disabled:cursor-not-allowed disabled:opacity-60">
              {currentLocale === 'vi' ? 'Nhận tư vấn VIP' : 'Request VIP consultation'}
            </button>
            <p id="vip-lead-status" class="sm:col-span-2 min-h-5 text-xs" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      
      <!-- Col 1: Brand & Sovereign Authority -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-[#c9a54e] flex items-center justify-center text-[#07111e] font-serif font-bold text-base">
            4U
          </div>
          <span class="font-serif tracking-wider text-base font-bold text-white uppercase">
            Travel4You Sovereign
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          {currentLocale === 'vi'
            ? 'Mạng lưới biên tập độc lập tuyển chọn những hành trình VIP, du thuyền riêng và trải nghiệm văn hóa đặc sắc. Giúp du khách tinh tế tiếp cận những lựa chọn đáng tin cậy và phù hợp.'
            : "The sovereign editorial network curating the world's most breathtaking VIP journeys, private charters, and cultural sanctuaries. Empowering discerning travelers with priority fast-track access."}
        </p>
        <div class="inline-flex items-center space-x-2 bg-slate-900 border border-slate-700/80 rounded-lg px-3 py-1.5 text-[11px] text-[#c9a54e]">
          <span>👑</span>
          <span class="font-bold">{currentLocale === 'vi' ? 'Đối tác trải nghiệm chính thức của GetYourGuide' : 'Official GetYourGuide Verified Partner'}</span>
        </div>
      </div>

      <!-- Col 2: Top Destinations -->
      <div>
        <h4 class="font-serif text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-[#c9a54e] pl-2.5">
          {currentLocale === 'vi' ? 'Điểm đến tuyển chọn' : 'Curated Destinations'}
        </h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/experience/paris-seine-dinner-cruise-eiffel-tower-vip/" class="hover:text-[#c9a54e] transition-colors">Paris Seine VIP Dinner Cruises</a></li>
          <li><a href="/experience/rome-colosseum-underground-arena-vatican-vip/" class="hover:text-[#c9a54e] transition-colors">Rome Colosseum Underground & Vatican</a></li>
          <li><a href="/experience/lake-como-private-boat-tour-bellagio/" class="hover:text-[#c9a54e] transition-colors">Lake Como Wooden Boat Charters</a></li>
          <li><a href="/experience/kyoto-arashiyama-bamboo-tea-ceremony-vip/" class="hover:text-[#c9a54e] transition-colors">Kyoto Arashiyama & Private Tea Houses</a></li>
          <li><a href="/experience/maldives-luxury-catamaran-manta-snorkeling/" class="hover:text-[#c9a54e] transition-colors">Maldives Luxury Catamarans & Manta Rays</a></li>
          <li><a href="/experience/venice-grand-canal-private-gondola-serenade-doges-palace-vip/" class="hover:text-[#c9a54e] transition-colors">Venice Grand Canal & Private Gondolas</a></li>
        </ul>
      </div>

      <!-- Col 3: Trust & Guarantees -->
      <div>
        <h4 class="font-serif text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-[#c9a54e] pl-2.5">
          {currentLocale === 'vi' ? 'Thông tin cần biết trước khi đặt' : 'Sovereign Guarantees'}
        </h4>
        <ul class="space-y-3 text-xs">
          <li class="flex items-start space-x-2">
            <span class="text-[#c9a54e] font-bold">✓</span>
            <span><strong>{currentLocale === 'vi' ? 'Hủy linh hoạt:' : 'Flexible cancellation:'}</strong> {currentLocale === 'vi' ? 'Điều kiện hủy và hoàn tiền tùy từng trải nghiệm; hãy kiểm tra chính sách hiện hành của nhà cung cấp trước khi đặt.' : 'Terms and refund eligibility vary by experience; verify the live provider policy before booking.'}</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-[#c9a54e] font-bold">✓</span>
            <span><strong>{currentLocale === 'vi' ? 'Vé QR trên điện thoại:' : 'Mobile QR Vouchers:'}</strong> {currentLocale === 'vi' ? 'Nhận vé điện tử để làm thủ tục thuận tiện trên điện thoại.' : 'Paperless instant check-in directly through smartphone wallets.'}</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-[#c9a54e] font-bold">✓</span>
            <span><strong>{currentLocale === 'vi' ? 'Thanh toán an toàn:' : 'Secure payment:'}</strong> {currentLocale === 'vi' ? 'Giá và phương thức thanh toán hiển thị theo điều kiện của nền tảng đặt chỗ.' : 'Settle securely in your local currency with zero foreign fees.'}</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: 12 Languages & Legal Compliance -->
      <div>
        <h4 class="font-serif text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-[#c9a54e] pl-2.5">
          {currentLocale === 'vi' ? 'Ngôn ngữ (12)' : 'Global Locales (12)'}
        </h4>
        <div class="flex flex-wrap gap-1.5 text-[11px] mb-4">
          <a href="/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">EN</a>
          <a href="/vi/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">VI</a>
          <a href="/de/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">DE</a>
          <a href="/fr/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">FR</a>
          <a href="/es/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">ES</a>
          <a href="/it/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">IT</a>
          <a href="/ja/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">JA</a>
          <a href="/ko/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">KO</a>
          <a href="/zh-tw/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">ZH-TW</a>
          <a href="/zh-cn/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">ZH-CN</a>
          <a href="/pt/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">PT</a>
          <a href="/ru/" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:border-[#c9a54e] hover:text-[#c9a54e]">RU</a>
        </div>
        <div class="p-3 bg-slate-950/80 border border-slate-800/80 rounded-lg text-[11px] text-slate-400 leading-relaxed">
          {dict.disclaimer}
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-800/60 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>© {new Date().getFullYear()} Travel4You.app. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-slate-400">
        <span class="flex items-center space-x-1.5">
          <span class="text-[#c9a54e]">👑</span>
          <span>{currentLocale === 'vi' ? 'Tuyển chọn với tâm huyết bởi ' : 'Curated with love by '}<strong class="text-slate-200">Luxury Victor</strong> & <strong class="text-slate-200">Luxury Lucky</strong></span>
        </span>
      </div>
    </div>
  </div>
</footer>

{!isAppRoute && (
  <script is:inline>
    const form = document.getElementById('vip-lead-form');
    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = document.getElementById('vip-lead-status');
        const button = form.querySelector('button[type="submit"]');
        if (status) status.textContent = '';
        if (button) button.disabled = true;
        try {
          const response = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form)))
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'Unable to submit your request.');
          form.reset();
          if (status) {
            status.className = 'sm:col-span-2 min-h-5 text-xs text-emerald-300';
            status.textContent = document.documentElement.lang === 'vi' ? 'Đã nhận yêu cầu. Chúng tôi sẽ sớm liên hệ.' : 'Request received. Our concierge will be in touch soon.';
          }
        } catch (error) {
          if (status) {
            status.className = 'sm:col-span-2 min-h-5 text-xs text-rose-300';
            status.textContent = error.message;
          }
        } finally {
          if (button) button.disabled = false;
        }
      });
    }
  </script>
)}
