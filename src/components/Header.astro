---
import i18n from '../data/i18n.json';

interface Props {
  currentLocale?: string;
}

const { currentLocale = 'en' } = Astro.props;
const dict = (i18n as any)[currentLocale] || (i18n as any).en;

const languages = [
  { code: 'en', label: 'English', path: '/' },
  { code: 'vi', label: 'Tiếng Việt', path: '/vi/' },
  { code: 'de', label: 'Deutsch', path: '/de/' },
  { code: 'fr', label: 'Français', path: '/fr/' },
  { code: 'es', label: 'Español', path: '/es/' },
  { code: 'it', label: 'Italiano', path: '/it/' },
  { code: 'ja', label: '日本語', path: '/ja/' },
  { code: 'ko', label: '한국어', path: '/ko/' },
  { code: 'zh-tw', label: '繁體中文', path: '/zh-tw/' },
  { code: 'zh-cn', label: '简体中文', path: '/zh-cn/' },
  { code: 'pt', label: 'Português', path: '/pt/' },
  { code: 'ru', label: 'Русский', path: '/ru/' },
];

const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;
---

<header class="sticky top-0 z-50 bg-[#07111e]/95 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={homeUrl} class="group flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-[#c9a54e] via-[#dfba63] to-[#ff7043] p-0.5 shadow-lg shadow-[#c9a54e]/20 group-hover:scale-105 transition-transform duration-300">
          <div class="w-full h-full bg-[#07111e] rounded-[7px] flex items-center justify-center">
            <span class="text-xl font-bold font-serif text-[#c9a54e]">4U</span>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-serif tracking-widest text-lg font-bold text-white uppercase group-hover:text-[#c9a54e] transition-colors">
            Travel4You
          </span>
          <span class="text-[10px] tracking-[0.25em] text-[#c9a54e] uppercase font-semibold">
            {currentLocale === 'vi' ? 'Tư vấn du lịch thượng lưu' : 'Sovereign Concierge'}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
        <a href={homeUrl} class="hover:text-white transition-colors">{dict.nav_home}</a>
        <a href="#experiences" class="hover:text-[#c9a54e] transition-colors">{dict.nav_experiences}</a>
        <a href="#destinations" class="hover:text-[#c9a54e] transition-colors">{dict.nav_destinations}</a>
        <a href="#curator" class="hover:text-[#c9a54e] transition-colors">{dict.nav_curators}</a>
      </nav>

      <!-- Right Actions: Language & VIP CTA & Mobile Toggle -->
      <div class="flex items-center space-x-3 sm:space-x-4">
        
        <!-- Language Selector Dropdown (Desktop & Tablet) -->
        <div class="relative group">
          <button type="button" class="flex items-center space-x-2 bg-slate-900/80 border border-slate-700/60 rounded-full px-3.5 py-1.5 text-xs font-semibold text-slate-200 hover:border-[#c9a54e] transition-all">
            <span class="text-base">🌐</span>
            <span class="uppercase font-bold tracking-wider">{currentLocale}</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#c9a54e] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute right-0 mt-2 w-48 bg-[#0b1b30] border border-slate-700/80 rounded-xl shadow-2xl py-2 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 z-50">
            <div class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-800">
              {currentLocale === 'vi' ? 'Chọn ngôn ngữ' : 'Select Locale'}
            </div>
            <div class="max-h-64 overflow-y-auto py-1">
              {languages.map((lang) => (
                <a
                  href={lang.path}
                  class={`flex items-center justify-between px-3.5 py-2 text-xs hover:bg-[#11223f] transition-colors ${currentLocale === lang.code ? 'text-[#c9a54e] font-bold bg-[#11223f]/50' : 'text-slate-300'}`}
                >
                  <span>{lang.label}</span>
                  <span class="text-[10px] uppercase font-mono text-slate-400">{lang.code}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Official GYG Partner CTA (Desktop & Tablet) -->
        <a
          href="https://www.getyourguide.com/?partner_id=D5OEC57&cmp=t4u_app_header"
          target="_blank"
          rel="nofollow sponsored noopener"
          class="hidden sm:inline-flex items-center space-x-2 bg-gradient-to-r from-[#ff7043] to-[#f4511e] hover:from-[#f4511e] hover:to-[#e64a19] text-white text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-full shadow-lg shadow-[#ff7043]/20 hover:shadow-[#ff7043]/40 transition-all duration-300"
        >
          <span>{currentLocale === 'vi' ? 'GetYourGuide VIP' : 'GetYourGuide VIP'}</span>
          <span>→</span>
        </a>

        <!-- Mobile Hamburger Toggle Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg bg-slate-900 border border-slate-700/80 text-slate-300 hover:text-white hover:border-[#c9a54e] transition-all focus:outline-none"
          aria-label="          {currentLocale === 'vi' ? 'Mở hoặc đóng menu điều hướng' : 'Toggle Mobile Navigation'}"
          aria-expanded="false"
        >
          <svg id="icon-menu" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>

    </div>
  </div>

  <!-- Mobile Navigation Drawer (iPhone / Android / iPad) -->
  <div
    id="mobile-menu-drawer"
    class="hidden md:hidden bg-[#07111e] border-b border-slate-800 px-4 pt-4 pb-6 space-y-4 shadow-2xl transition-all duration-300"
  >
    <!-- Navigation Links -->
    <div class="space-y-1">
      <a
        href={homeUrl}
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-white hover:bg-[#0b1b30] text-sm font-semibold transition-colors"
      >
        <span>🏛️</span>
        <span class="ml-3">{dict.nav_home}</span>
      </a>
      <a
        href="#experiences"
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-[#c9a54e] hover:bg-[#0b1b30] text-sm font-semibold transition-colors"
      >
        <span>💎</span>
        <span class="ml-3">{dict.nav_experiences}</span>
      </a>
      <a
        href="#destinations"
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-[#c9a54e] hover:bg-[#0b1b30] text-sm font-semibold transition-colors"
      >
        <span>📍</span>
        <span class="ml-3">{dict.nav_destinations}</span>
      </a>
      <a
        href="#curator"
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-[#c9a54e] hover:bg-[#0b1b30] text-sm font-semibold transition-colors"
      >
        <span>👑</span>
        <span class="ml-3">{dict.nav_curators}</span>
      </a>
    </div>

    <!-- Mobile Language Selector Grid (12 Locales) -->
    <div class="pt-3 border-t border-slate-800/80">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2 px-1">
        {currentLocale === 'vi' ? 'Chọn ngôn ngữ (12 ngôn ngữ)' : 'Select Language (12 Locales)'}
      </span>
      <div class="grid grid-cols-3 gap-2">
        {languages.map((lang) => (
          <a
            href={lang.path}
            class={`flex items-center justify-center py-2 px-2.5 rounded-lg text-xs font-semibold border transition-all ${currentLocale === lang.code ? 'bg-[#c9a54e]/20 border-[#c9a54e] text-[#c9a54e]' : 'bg-slate-900/80 border-slate-800 text-slate-300 hover:border-slate-700'}`}
          >
            {lang.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile Curators Note -->
    <div class="p-3 bg-slate-900/90 border border-slate-800/80 rounded-xl text-xs text-slate-400">
      <span class="text-[#c9a54e] font-bold block mb-1">👑 Curators</span>
      <span>{currentLocale === 'vi' ? 'Tuyển chọn bởi Luxury Victor Travel4U và Luxury Lucky Travel4U. Đối tác GetYourGuide chính thức.' : 'Curated by Luxury Victor Travel4U & Luxury Lucky Travel4U. Verified GetYourGuide Partner.'}</span>
    </div>

    <!-- Mobile Direct GYG CTA -->
    <a
      href="https://www.getyourguide.com/?partner_id=D5OEC57&cmp=t4u_app_mobile_header"
      target="_blank"
      rel="nofollow sponsored noopener"
      class="flex items-center justify-center w-full py-3.5 bg-gradient-to-r from-[#ff7043] to-[#f4511e] text-white text-xs font-bold uppercase tracking-wider rounded-xl shadow-lg shadow-[#ff7043]/30"
    >
      <span>Browse GetYourGuide VIP Catalog →</span>
    </a>
  </div>

  <script is:inline>
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    if (toggleBtn && drawer && iconMenu && iconClose) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = drawer.classList.contains('hidden');
        if (isHidden) {
          drawer.classList.remove('hidden');
          iconMenu.classList.add('hidden');
          iconClose.classList.remove('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          drawer.classList.add('hidden');
          iconMenu.classList.remove('hidden');
          iconClose.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // Close drawer on link click
      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          drawer.classList.add('hidden');
          iconMenu.classList.remove('hidden');
          iconClose.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>
</header>
