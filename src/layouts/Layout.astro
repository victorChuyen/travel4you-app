---
interface Props {
  title: string;
  description: string;
  locale?: string;
  image?: string;
  schema?: any;
  canonicalUrl?: string;
}

const {
  title,
  description,
  locale = 'en',
  image = '/media/GYG_FR_PARIS_seine-river-gourmet-dinner-cruise-bateaux-parisiens_sunset-eiffel-landscape-4k.jpg',
  schema,
  canonicalUrl = Astro.url.href
} = Astro.props;

const locales = ['en', 'vi', 'de', 'fr', 'es', 'it', 'ja', 'ko', 'zh-tw', 'zh-cn', 'pt', 'ru'];
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || Astro.url.origin).href} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site || Astro.url.origin).href} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- GetYourGuide Official Widget Loader -->
    <script async defer src="https://widget.getyourguide.com/v2/widget.js"></script>

    <!-- Multi-Tenant Team Member Attribution Engine -->
    <script is:inline src="/scripts/team_attribution.js"></script>
  </head>
  <body class="bg-[#07111e] text-slate-100 font-sans antialiased selection:bg-[#c9a54e] selection:text-[#07111e] min-h-screen flex flex-col">
    <slot />

    <!-- Toast Notification Container -->
    <div id="t4u-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-[#0b1726]/95 border border-[#c9a54e]/60 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl backdrop-blur-md flex items-center space-x-2">
      <span id="toast-icon" class="text-base">✨</span>
      <span id="toast-msg">Notification message</span>
    </div>

    <script is:inline>
      // Global Bookmark & Social Share Engine
      function showToast(msg, icon = '✨') {
        const toast = document.getElementById('t4u-toast');
        const toastMsg = document.getElementById('toast-msg');
        const toastIcon = document.getElementById('toast-icon');
        if (!toast || !toastMsg) return;

        toastMsg.textContent = msg;
        if (toastIcon) toastIcon.textContent = icon;

        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }, 3000);
      }

      function initBookmarks() {
        let bookmarks = [];
        try {
          bookmarks = JSON.parse(localStorage.getItem('t4u_bookmarks') || '[]');
        } catch (e) {
          bookmarks = [];
        }

        // Render existing bookmarks state
        document.querySelectorAll('.bookmark-btn').forEach(btn => {
          const slug = btn.getAttribute('data-slug');
          const heartIcon = btn.querySelector('.heart-icon');
          if (bookmarks.includes(slug)) {
            btn.classList.add('text-rose-500', 'border-rose-500/60');
            if (heartIcon) {
              heartIcon.setAttribute('fill', 'currentColor');
            }
          }

          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const isSaved = bookmarks.includes(slug);
            if (isSaved) {
              bookmarks = bookmarks.filter(s => s !== slug);
              btn.classList.remove('text-rose-500', 'border-rose-500/60');
              if (heartIcon) heartIcon.setAttribute('fill', 'none');
              showToast('Removed from your private wishlist', '🤍');
            } else {
              bookmarks.push(slug);
              btn.classList.add('text-rose-500', 'border-rose-500/60');
              if (heartIcon) heartIcon.setAttribute('fill', 'currentColor');
              showToast('Saved to your private VIP wishlist!', '❤️');
            }
            localStorage.setItem('t4u_bookmarks', JSON.stringify(bookmarks));
          });
        });

        // Global Share Handlers
        document.querySelectorAll('.card-share-btn, .page-share-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();

            const url = btn.getAttribute('data-url') || window.location.href;
            const fullUrl = url.startsWith('http') ? url : window.location.origin + url;
            const title = btn.getAttribute('data-title') || document.title;

            if (navigator.share) {
              try {
                await navigator.share({
                  title: title,
                  text: 'Explore this curated VIP experience on Travel4You Sovereign Concierge:',
                  url: fullUrl
                });
                return;
              } catch (err) {
                // User cancelled or unsupported
              }
            }

            // Fallback: Copy to clipboard
            try {
              await navigator.clipboard.writeText(fullUrl);
              showToast('Link copied to clipboard!', '🔗');
            } catch (err) {
              showToast('Share link: ' + fullUrl, '📋');
            }
          });
        });
      }

      document.addEventListener('DOMContentLoaded', initBookmarks);
    </script>
  </body>
</html>
